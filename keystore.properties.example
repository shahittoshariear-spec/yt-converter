# Copy this file to keystore.properties and fill in your own values.
# keystore.properties is git-ignored; never commit the real one.
#
# Create the key with:
#   keytool -genkeypair -v -keystore app/keystore/release.jks \
#     -alias ytconverter -keyalg RSA -keysize 4096 -validity 10000
#
storeFile=app/keystore/release.jks
storePassword=change-me
keyAlias=ytconverter
keyPassword=change-me
